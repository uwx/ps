{
    "compilerOptions": {
        "resolveJsonModule": true,
        "allowUnreachableCode": false,
        "allowUnusedLabels": false,
        "declaration": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "incremental": true,
        "lib": ["es2016", "dom"],
        "module": "commonjs",
        "noFallthroughCasesInSwitch": true,
        "noImplicitReturns": true,
        "sourceMap": true,
        "strict": true,
        "target": "es2018",
        "tsBuildInfoFile": ".tsbuildinfo",
        "verbatimModuleSyntax": false,
        "composite": true,
        "paths": {
            "@pkmn/client": ["./client"],
            "@pkmn/data": ["./data"],
            "@pkmn/dex": ["./dex"],
            "@pkmn/img": ["./img"],
            "@pkmn/integration": ["./integration"],
            "@pkmn/login": ["./login"],
            "@pkmn/mods": ["./mods"],
            "@pkmn/protocol": ["./protocol"],
            "@pkmn/randoms": ["./randoms"],
            "@pkmn/sets": ["./sets"],
            "@pkmn/sim": ["./sim"],
            "@pkmn/streams": ["./streams"],
            "@pkmn/types": ["./types"],
            "@pkmn/view": ["./view"],
            "@pkmn/dex-types": ["./dex/types"],
        }
    },
    "files": [],
    "include": [],
    "exclude": [],
}